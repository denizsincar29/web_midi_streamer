# Caddy snippet for jamrtc.denizsincar.ru
# Add this block to your Caddyfile (or adapt for your global config).
#
# The signaler runs on localhost:8765.
# Caddy proxies /signal, /rooms, /hide-room, /show-room to it so the
# frontend can reach them via the same HTTPS subdomain — no port exposure needed.
#
# The static frontend files are served from /var/www/html/jamrtc.

jamrtc.denizsincar.ru {
    # WebSocket upgrade + HTTP endpoints for the signaler
    handle /signal*    { reverse_proxy localhost:8987 }
    handle /rooms      { reverse_proxy localhost:8987 }
    handle /hide-room* { reverse_proxy localhost:8987 }
    handle /show-room* { reverse_proxy localhost:8987 }
    handle /health     { reverse_proxy localhost:8987 }

    # NVDA addon download — never cache so users always get the latest build
    handle /nvda_addon/*.nvda-addon {
        root * /var/www/html/jamrtc
        header Cache-Control "no-store, must-revalidate"
        file_server
    }

    # Everything else: static frontend
    handle {
        root * /var/www/html/jamrtc
        file_server
    }
}
