# ntfy push notifications for JamRTC room events
# Copy this to .env and fill in your values.
# The service unit loads this file via EnvironmentFile.

# ntfy server URL (no trailing slash)
# Public server: https://ntfy.sh
# Self-hosted:   https://ntfy.yourdomain.com
NTFY_URL=https://ntfy.sh

# Topic name — keep this secret if using ntfy.sh (anyone who knows it can subscribe)
NTFY_TOPIC=jamrtc-yourname

# Optional: Bearer token for private/authenticated topics
# Leave empty for public topics
NTFY_TOKEN=
