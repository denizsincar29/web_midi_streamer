[Unit]
Description=JamRTC WebRTC Signaling Server
After=network.target

[Service]
Type=simple
User=denizsincar29
WorkingDirectory=/home/denizsincar29/web_midi_streamer/signaler
EnvironmentFile=-/home/denizsincar29/web_midi_streamer/signaler/.env
ExecStart=/home/denizsincar29/web_midi_streamer/signaler/signaler -addr :8987
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jamrtc-signaler
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
